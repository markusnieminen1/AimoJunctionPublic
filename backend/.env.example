# Database (SQLite default, or mysql+pymysql://user:pass@127.0.0.1:3306/aimoannos)
DATABASE_URL=sqlite:///./aimoannos.db

# Auth
JWT_SECRET=dev-insecure-secret-change-me

# Supplier API (offline fixture mode by default; replace URL & key only for live integration)
AIMO_BASE_URL=https://api.example.invalid
AIMO_API_KEY=
AIMO_MODE=fixture

# Demo clock override (optional ISO 8601 timestamp, e.g. 2026-11-15T14:00:00+02:00)
APP_NOW=

# LLM providers (offline deterministic fake mode by default)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
LLM_MODEL=claude-sonnet-4-5
FAST_LLM_PROVIDER=fake
FAST_LLM_MODEL=google/gemma-4-31B-it
FAST_LLM_FALLBACK_MODEL=google/gemma-4-26B-A4B-it
LLM_MAX_CALLS_PER_HOUR=200

# Optional Telegram Bot Bridge
TELEGRAM_BOT_USERNAME=your_aimo_bot
TELEGRAM_BOT_TOKEN=

# Order gateway simulation (none | timeout_after_accept | error)
ORDER_GATEWAY_SIMULATE=none

# App runtime
APP_ENV=dev
PORT=8001
VERSION=0.1.0
